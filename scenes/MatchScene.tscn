; ===== BATTLE LINE / PLATFORM (where heroes stand) =====
; Glowing magical disc that spans the battle line. Heroes are positioned with
; their feet planted on the upper-front edge of the disc.
;
; Two-disc layout: a wider faint glow underlay + a brighter centered disc on top
; gives depth without stretching the swirl into a smear. Both use platform.png.
;
; The red SpawnLine trim sits at the very top edge as the combat marker —
; MatchScene.gd drives its modulate.a via _spawn_line_set_phase() to dim in
; Phase 1 and pulse in Phase 2.
[node name="PlatformGlow" type="TextureRect" parent="."]
texture = ExtResource("9_platform")
offset_left = -700.0
offset_top = 930.0
offset_right = 1140.0
offset_bottom = 1140.0
expand_mode = 1
stretch_mode = 0
modulate = Color(0.7, 0.85, 1.0, 0.55)

[node name="Platform" type="TextureRect" parent="."]
texture = ExtResource("9_platform")
offset_left = -600.0
offset_top = 955.0
offset_right = 1040.0
offset_bottom = 1115.0
expand_mode = 1
stretch_mode = 0

; Red trim line — the combat marker. Phase 1: dim. Phase 2: pulse.
; MatchScene.gd drives modulate.a via _spawn_line_set_phase().
[node name="SpawnLine" type="ColorRect" parent="."]
